# ==========================================
# Unity 官方推荐 .gitignore 模板
# ==========================================

# 忽略 Unity 自动生成的缓存和临时文件夹
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# 忽略 Visual Studio / Rider 等 IDE 生成的文件
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 忽略打包生成的可执行文件
*.apk
*.aab
*.unitypackage
*.app
*.exe

# 忽略操作系统生成的文件
.DS_Store
Thumbs.db
*.swp

# 忽略测试覆盖率报告
/[Tt]est[Rr]esults/